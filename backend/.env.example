# نمونه‌ی متغیرهای محیطی بک‌اند. برای استفاده، این را به .env کپی کن.
# در توسعه اگر .env نگذاری هم کار می‌کند (پیش‌فرض: SQLite، DEBUG از settings).
#
# روی سرور این فایل را دستی نساز — deploy/install.sh خودش .env تولید می‌کند.
# راهنمای راه‌اندازی روی سرور: deploy/README.md

# --- عمومی ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# با کاما جدا کن: example.com,api.example.ir
ALLOWED_HOSTS=*

# --- پایگاه‌داده ---
# پیش‌فرض sqlite (بدون نیاز به مقدار). برای Postgres:
# DB_ENGINE=postgres
# DB_NAME=economy
# DB_USER=economy
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- خانواده ---
FAMILY_MAX_MEMBERS=3

# --- تولید (production settings) ---
# پشت HTTPS این‌ها True بمانند؛ برای تستِ HTTP-only روی IP، هر سه را False کن
# تا ورود به پنل ادمین بدون گواهی SSL هم ممکن باشد (فقط برای تست).
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# دامنه‌هایی که پنل ادمین از آن‌ها POST می‌کند (پیش‌فرض از ALLOWED_HOSTS ساخته می‌شود):
# CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
